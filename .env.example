# MIRCrew Proxy - Environment Variables
# Copia questo file in .env e configura le variabili

# Credenziali MIRCrew (OBBLIGATORIO)
MIRCREW_USERNAME=your_username
MIRCREW_PASSWORD=your_password

# URL base del sito
MIRCREW_URL=https://mircrew-releases.org

# API Key per Prowlarr (scegli una chiave sicura)
MIRCREW_API_KEY=mircrew-api-key

# Porta del proxy server
PROXY_PORT=9696

# Byparr/FlareSolverr URL (per bypass Cloudflare)
# Se usi il docker-compose incluso, lascia il default
FLARESOLVERR_URL=http://byparr:8191

# Immagine Docker di Byparr (per evitare aggiornamenti automatici che rompono il bypass)
# Consigliato: fissa un tag o digest specifico da https://github.com/ThePhaseless/Byparr/pkgs/container/byparr
# Es: ghcr.io/thephaseless/byparr:main oppure ghcr.io/thephaseless/byparr@sha256:<digest>
# BYPARR_IMAGE=ghcr.io/thephaseless/byparr:latest

# Siti abilitati (separati da virgola)
ENABLED_SITES=mircrew

# Indexer esterni da monitorare nel pannello admin: nome=url, separati da virgola.
# L'URL e' quello raggiungibile da questo container (stessa rete Docker).
# EXTERNAL_INDEXERS=animeworld=http://animeworldtv-indexer:9698
# EXTERNAL_INDEXERS_API_KEY=

# Pannello admin senza login per queste reti (solo se il pannello NON e' pubblico).
# Il proxy fidato e' quello da cui leggere X-Forwarded-For (es. il gateway Docker).
# ADMIN_TRUSTED_NETWORKS=192.168.1.0/24,100.114.0.0/16
# ADMIN_TRUSTED_PROXIES=172.22.0.1

# Livello di log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
